{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "format": {
      "type": "string",
      "const": "iz/1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "hostSuffix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "clock": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "session",
            "global"
          ]
        },
        "epoch": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "mode",
        "epoch"
      ],
      "additionalProperties": false
    },
    "hosts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1
          },
          "service": {
            "type": "string",
            "enum": [
              "forge",
              "mail",
              "archive",
              "terminal",
              "forum"
            ]
          },
          "title": {
            "type": "string"
          },
          "requires": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "host",
          "service"
        ],
        "additionalProperties": false
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "reports": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "version",
    "format",
    "title",
    "summary",
    "license",
    "hostSuffix",
    "clock",
    "hosts",
    "entry",
    "reports"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gateSolved": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "gateSolved"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidenceCollected": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "evidenceCollected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "factEstablished": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "factEstablished"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "timeReached": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "timeReached"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "teamSizeAtLeast": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "teamSizeAtLeast"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
