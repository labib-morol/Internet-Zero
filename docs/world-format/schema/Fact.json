{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "proposition": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "subject",
        "predicate",
        "object"
      ],
      "additionalProperties": false
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "validTo": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "required": {
      "default": false,
      "type": "boolean"
    },
    "secrecy": {
      "default": "hidden",
      "type": "string",
      "enum": [
        "public",
        "hidden",
        "secret"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "proposition"
  ],
  "additionalProperties": false
}
