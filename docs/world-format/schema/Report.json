{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slots": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "identity",
                    "date",
                    "choice",
                    "text"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fact": {
                  "type": "string",
                  "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
                },
                "answers": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "label",
                "type",
                "fact",
                "answers"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "slots"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "groups"
  ],
  "additionalProperties": false
}
