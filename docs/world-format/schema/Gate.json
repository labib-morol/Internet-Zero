{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "$ref": "#/$defs/__schema0"
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "answer"
            },
            "normalize": {
              "default": [
                "nfkc",
                "lower",
                "trim",
                "collapse"
              ],
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "nfkc",
                  "lower",
                  "trim",
                  "collapse",
                  "stripPunct"
                ]
              }
            },
            "answers": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "answers"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "report"
            },
            "report": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "kind",
            "report"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "evidenceSet"
            },
            "mustCollect": {
              "minItems": 0,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
              }
            },
            "mustLink": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
                  },
                  "relation": {
                    "type": "string"
                  }
                },
                "required": [
                  "from",
                  "to",
                  "relation"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "mustCollect"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "terminal"
            },
            "mustHaveRead": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "host": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "mustHaveRead",
            "host"
          ],
          "additionalProperties": false
        }
      ]
    },
    "unlocks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "score": {
      "default": 100,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "title",
    "check"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gateSolved": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "gateSolved"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "evidenceCollected": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "evidenceCollected"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "factEstablished": {
              "type": "string",
              "pattern": "^[a-z]+\\.[a-z0-9][a-z0-9._-]{0,63}$"
            }
          },
          "required": [
            "factEstablished"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "timeReached": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "timeReached"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "teamSizeAtLeast": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "teamSizeAtLeast"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
