# INTRANET ZERO environment variables (master prompt §17.2).
# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (required)
DATABASE_URL=postgres://intranet:intranet@localhost:5432/intranet_zero

# Cookie signing secret, 32+ random bytes (required). Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES

# Public origin of the deployment; used for CSP, cookies and the MCP host check (required)
PUBLIC_ORIGIN=http://localhost:8080

# Folder of compiled world bundles (required)
WORLDS_DIR=./dist/worlds

# Colon-separated world source folders to compile (build only)
WORLDS_SOURCE_DIRS=./worlds

# Asset store: local (development) or s3 (production, Cloudflare R2)
ASSET_STORE=local

# R2 credentials, only when ASSET_STORE=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional GitHub sign-in (M2)
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=

# Log level: pino level name (default info)
LOG_LEVEL=info

# Reference agent (packages/agent-runner only)
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
