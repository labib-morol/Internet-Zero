  },
  "dependencies": {
    "@iz/runtime": "workspace:*",
    "@iz/schema": "workspace:*",
    "@iz/services": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
